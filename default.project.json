{
  "name": "roblox-live-pc-screen",
  "tree": {
    "$className": "DataModel",
    "HttpService": {
      "$properties": {
        "HttpEnabled": true
      }
    },
    "ReplicatedStorage": {
      "Rlps": {
        "$className": "Folder",
        "RlpsProtocol": {
          "$path": "roblox/src/shared/RlpsProtocol.luau"
        },
        "RlpsDecoder": {
          "$path": "roblox/src/shared/RlpsDecoder.luau"
        },
        "RlpsClientCore": {
          "$path": "roblox/src/shared/RlpsClientCore.luau"
        },
        "RlpsDct": {
          "$path": "roblox/src/shared/RlpsDct.luau"
        },
        "RlpsView": {
          "$path": "roblox/src/shared/RlpsView.luau"
        }
      }
    },
    "ServerScriptService": {
      "Rlps": {
        "$className": "Folder",
        "RlpsServer": {
          "$path": "roblox/src/server/RlpsServer.server.luau",
          "$attributes": {
            "FrameServiceUrl": "",
            "SecretName": "rlps_token",
            "PollWaitMs": 15000,
            "MinPollInterval": 0.15,
            "StoppedPollInterval": 1,
            "BatchMs": 150,
            "MaxBytesPerSecond": 8000000,
            "StartBytesPerSecond": 1000000,
            "MinBytesPerSecond": 100000,
            "TargetLagSeconds": 0.35,
            "ClientDecodeBudgetMs": 10,
            "ViewerUserIds": "",
            "ViewerModes": "fullscreen,cinema,mini"
          }
        },
        "RlpsRelayCore": {
          "$path": "roblox/src/server/RlpsRelayCore.luau"
        },
        "RlpsFanout": {
          "$path": "roblox/src/server/RlpsFanout.luau"
        },
        "RlpsProtocol": {
          "$path": "roblox/src/shared/RlpsProtocol.luau"
        },
        "RlpsDecoder": {
          "$path": "roblox/src/shared/RlpsDecoder.luau"
        },
        "RlpsBase64": {
          "$path": "roblox/src/shared/RlpsBase64.luau"
        },
        "RlpsDct": {
          "$path": "roblox/src/shared/RlpsDct.luau"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "RlpsClient": {
          "$path": "roblox/src/client/RlpsClient.client.luau"
        }
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [
            256,
            2,
            256
          ],
          "CFrame": [
            0,
            -1,
            0,
            1,
            0,
            0,
            0,
            1,
            0,
            0,
            0,
            1
          ],
          "Color": [
            0.39,
            0.37,
            0.38
          ],
          "Material": "Concrete",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [
            6,
            1,
            6
          ],
          "CFrame": [
            0,
            0.5,
            0,
            1,
            0,
            0,
            0,
            1,
            0,
            0,
            0,
            1
          ],
          "Duration": 0,
          "Neutral": true,
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "RlpsTV": {
        "$path": "roblox/models/RlpsTV.model.json"
      }
    }
  }
}
